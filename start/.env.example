# Devin API service key (server-side only, never sent to the browser)
DEVIN_API_KEY=cog_your_api_key_here
# Devin organization the sessions are created in (prefix: org-)
DEVIN_ORG_ID=org-your_org_id_here
# Email of the org member sessions are attributed to
DEVIN_USER_EMAIL=you@yourcompany.com
# Local server port (optional)
PORT=3000
